@@ -0,0 +1,197 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  englishCardHtml,
+  ensureFrontMatter,
+  insertCardByDate,
+  insertSitemapUrls,
+  noonUtcIso,
+  previewPublishBlog,
+  publishBlog,
+  slugify,
+  validatePostCopy
+} from "../src/publish-blog.js";
+import { executeTool, grokTools } from "../src/tools.js";
+
+test("publish_blog appears when GITHUB_TOKEN is set", () => {
+  const names = grokTools({ GITHUB_TOKEN: "gh" }).map((tool) => tool.function.name);
+  assert.equal(names.includes("publish_blog"), true);
+  assert.equal(names.includes("github_get"), true);
+});
+
+test("slugify and noon UTC date", () => {
+  assert.equal(slugify("NCH Drops Cigna!"), "nch-drops-cigna");
+  assert.equal(noonUtcIso("2026-09-01"), "2026-09-01T12:00:00.000Z");
+});
+
+test("validatePostCopy blocks placeholders and plan steering", () => {
+  assert.equal(validatePostCopy("Content unavailable"), "Refusing placeholder copy (Content unavailable / lorem).");
+  assert.match(
+    validatePostCopy("You should enroll in a Cigna plan"),
+    /plan-recommendation/
+  );
+  assert.equal(validatePostCopy("We do not pick the plan. Check the 2027 directory."), null);
+});
+
+test("ensureFrontMatter adds Eleventy YAML when missing", () => {
+  const md = ensureFrontMatter("# Hello", {
+    layout: "layouts/blog-post.njk",
+    category: "Medicare",
+    title: "NCH Drops Cigna",
+    description: "Check the 2027 network.",
+    dateIso: "2026-09-01T12:00:00.000Z",
+    lang: "en",
+    permalink: "/blog/nch-drops-cigna/"
+  });
+  assert.match(md, /^---\nlayout: layouts\/blog-post.njk/);
+  assert.match(md, /permalink: \/blog\/nch-drops-cigna\//);
+  assert.match(md, /# Hello/);
+});
+
+test("insertCardByDate keeps newest-first EN order", () => {
+  const listing = `<div class="card-grid" id="blogGrid">
+<a class="blog-card" href="/blog/sep9/"><span class="card-date">2026-09-09</span></a>
+<a class="blog-card" href="/blog/sep2/"><span class="card-date">2026-09-02</span></a>
+<a class="blog-card" href="/blog/aug26/"><span class="card-date">2026-08-26</span></a>
+</div>`;
+  const card = englishCardHtml({
+    category: "Medicare",
+    slug: "nch",
+    title: "NCH",
+    excerpt: "Check 2027.",
+    date: "2026-09-01"
+  });
+  const out = insertCardByDate(listing, card, "2026-09-01");
+  const dates = [...out.matchAll(/card-date">(\d{4}-\d{2}-\d{2})/g)].map((m) => m[1]);
+  assert.deepEqual(dates, ["2026-09-09", "2026-09-02", "2026-09-01", "2026-08-26"]);
+});
+
+test("insertCardByDate position=first puts the news card on top", () => {
+  const listing = `<div class="card-grid" id="blogGrid">
+    <a href="/es/blog/old/" class="blog-card"><span class="card-date">2026-01-01</span></a>
+</div>`;
+  const out = insertCardByDate(listing, "<a class=\"blog-card\">NEW</a>", "2026-09-01", { position: "first" });
+  assert.match(out, /id="blogGrid">\s*<a class="blog-card">NEW<\/a>/);
+});
+
+test("insertSitemapUrls adds EN/ES hreflang pair", () => {
+  const xml = `<?xml version="1.0"?>
+<urlset>
+<url><loc>https://www.healthexps.com/</loc></url>
+</urlset>`;
+  const out = insertSitemapUrls({
+    sitemap: xml,
+    enUrl: "https://www.healthexps.com/blog/nch/",
+    esUrl: "https://www.healthexps.com/es/blog/nch/",
+    lastmod: "2026-09-01"
+  });
+  assert.match(out, /blog\/nch\/<\/loc>/);
+  assert.match(out, /hreflang="es"/);
+  assert.match(out, /<\/urlset>/);
+});
+
+test("publish_blog requires confirmed=true", async () => {
+  const result = await executeTool("publish_blog", {
+    enSlug: "nch-drops-cigna-wellcare-medicare-advantage-2027",
+    enTitle: "NCH Drops Cigna and Wellcare Medicare Advantage in 2027",
+    enDescription: "NCH will drop Cigna and Wellcare MA on Jan. 1, 2027. We do not pick the plan.",
+    enMarkdown: "# Naples hospital will drop two Medicare Advantage contracts in 2027\n\nWe do not pick the plan."
+  }, { environment: { GITHUB_TOKEN: "gh" } });
+  assert.equal(result.needsConfirmation, true);
+  assert.equal(result.action, "publish_blog");
+  assert.equal(result.mode, "pr");
+});
+
+test("previewPublishBlog builds bilingual files", () => {
+  const preview = previewPublishBlog({
+    enSlug: "nch-en",
+    enTitle: "NCH EN",
+    enDescription: "Check 2027.",
+    enMarkdown: "# EN\n\nWe do not pick the plan.",
+    esSlug: "nch-es",
+    esTitle: "NCH ES",
+    esDescription: "Revise 2027.",
+    esMarkdown: "# ES\n\nNo elegimos el plan.",
+    date: "2026-09-01",
+    mode: "live"
+  });
+  assert.equal(preview.mode, "live");
+  assert.match(preview.enMarkdown, /hreflang_es: \/es\/blog\/nch-es\//);
+  assert.match(preview.esMarkdown, /hreflang_en: nch-en/);
+  assert.equal(preview.enUrl, "https://www.healthexps.com/blog/nch-en/");
+});
+
+test("publish_blog writes files, listing, sitemap, and opens a PR", async () => {
+  const calls = [];
+  const files = {
+    "blog/index.html": Buffer.from(`<div class="card-grid" id="blogGrid">
+<a class="blog-card" href="/blog/old/"><span class="card-date">2026-08-01</span></a>
+</div>`).toString("base64"),
+    "es/blog/index.html": Buffer.from(`<div class="card-grid" id="blogGrid">
+    <a href="/es/blog/old/" class="blog-card"><span class="card-date">2026-01-01</span></a>
+</div>`).toString("base64"),
+    "sitemap.xml": Buffer.from("<?xml version=\"1.0\"?><urlset></urlset>").toString("base64")
+  };
+
+  const result = await publishBlog({
+    enSlug: "nch-en",
+    enTitle: "NCH EN",
+    enDescription: "Check 2027.",
+    enMarkdown: "# EN\n\nWe do not pick the plan.",
+    esSlug: "nch-es",
+    esTitle: "NCH ES",
+    esDescription: "Revise 2027.",
+    esMarkdown: "# ES\n\nNo elegimos el plan.",
+    date: "2026-09-01",
+    mode: "pr",
+    confirmed: true
+  }, {
+    environment: { GITHUB_TOKEN: "gh" },
+    fetchImpl: async (url, opts = {}) => {
+      const method = opts.method || "GET";
+      calls.push({ method, url });
+      const body = opts.body ? JSON.parse(opts.body) : {};
+      if (url.endsWith("/git/ref/heads/main") && method === "GET") {
+        return json({ object: { sha: "abc123" } });
+      }
+      if (url.endsWith("/git/refs") && method === "POST") {
+        return json({ ref: body.ref });
+      }
+      if (url.includes("/contents/") && method === "GET") {
+        const path = decodeURIComponent(url.split("/contents/")[1].split("?")[0]);
+        if (files[path]) {
+          return json({ sha: `sha-${path}`, content: files[path], encoding: "base64" });
+        }
+        return json({ message: "Not Found" }, 404);
+      }
+      if (url.includes("/contents/") && method === "PUT") {
+        const path = decodeURIComponent(url.split("/contents/")[1]);
+        files[path] = body.content;
+        return json({ content: { path } });
+      }
+      if (url.endsWith("/pulls") && method === "POST") {
+        return json({ html_url: "https://github.com/yperez-dot/healthexps-www/pull/99", number: 99 });
+      }
+      return json({ message: `unexpected ${method} ${url}` }, 500);
+    }
+  });
+
+  assert.equal(result.published, true);
+  assert.equal(result.merged, false);
+  assert.equal(result.prNumber, 99);
+  assert.ok(files["blog/nch-en.md"]);
+  assert.ok(files["es/blog/nch-es.md"]);
+  const listing = Buffer.from(files["blog/index.html"], "base64").toString("utf8");
+  assert.match(listing, /nch-en/);
+  const sitemap = Buffer.from(files["sitemap.xml"], "base64").toString("utf8");
+  assert.match(sitemap, /blog\/nch-en\//);
+  assert.equal(calls.some((c) => c.url.endsWith("/pulls") && c.method === "POST"), true);
+});
+
+function json(body, status = 200) {
+  return {
+    ok: status >= 200 && status < 300,
+    status,
+    text: async () => JSON.stringify(body)
+  };
+}
