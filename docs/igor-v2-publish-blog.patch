+/**
+ * Telegram Igor → healthexps.com blog publish.
+ * Writes Eleventy markdown + listing cards + sitemap on yperez-dot/healthexps-www
+ * via the GitHub Contents API, then opens a PR (and optionally merges).
+ */
+
+export const SITE_REPO = "yperez-dot/healthexps-www";
+export const SITE_OWNER = "yperez-dot";
+export const SITE_NAME = "healthexps-www";
+export const DEFAULT_BASE_BRANCH = "main";
+
+const PLACEHOLDER_RE = /content unavailable|lorem ipsum|TODO:\s*write|placeholder copy/i;
+const PLAN_STEER_RE =
+  /\b(you should (enroll in|pick|choose|get|switch to)|i recommend|best (medicare )?(advantage )?plan|switch to (cigna|wellcare|uhc|united|humana|aetna))\b/i;
+
+export function slugify(value) {
+  return String(value ?? "")
+    .trim()
+    .toLowerCase()
+    .replace(/['’]/g, "")
+    .replace(/[^a-z0-9]+/g, "-")
+    .replace(/^-+|-+$/g, "")
+    .slice(0, 80);
+}
+
+export function noonUtcIso(ymd) {
+  const match = String(ymd ?? "").trim().match(/^(\d{4}-\d{2}-\d{2})/);
+  if (!match) return null;
+  return `${match[1]}T12:00:00.000Z`;
+}
+
+export function todayYmdET(now = new Date()) {
+  return now.toLocaleDateString("en-CA", { timeZone: "America/New_York" });
+}
+
+export function ensureFrontMatter(markdown, fields) {
+  const text = String(markdown ?? "").trim();
+  if (text.startsWith("---")) return text.endsWith("\n") ? text : `${text}\n`;
+  const lines = [
+    "---",
+    `layout: ${fields.layout}`,
+    `category: ${JSON.stringify(fields.category)}`,
+    `title: ${JSON.stringify(fields.title)}`,
+    `description: ${JSON.stringify(fields.description)}`,
+    `date: ${fields.dateIso}`,
+    `lang: ${fields.lang}`
+  ];
+  if (fields.hreflangEs) lines.push(`hreflang_es: ${fields.hreflangEs}`);
+  if (fields.hreflangEn) lines.push(`hreflang_en: ${fields.hreflangEn}`);
+  lines.push(`permalink: ${fields.permalink}`, "---", "", text, "");
+  return lines.join("\n");
+}
+
+export function validatePostCopy(markdown) {
+  const text = String(markdown ?? "");
+  if (!text.trim()) return "Post body is empty.";
+  if (PLACEHOLDER_RE.test(text)) return "Refusing placeholder copy (Content unavailable / lorem).";
+  if (PLAN_STEER_RE.test(text)) {
+    return "Refusing plan-recommendation copy. Licensed agent walks it — we do not pick the plan.";
+  }
+  return null;
+}
+
+export function englishCardHtml({ category, slug, title, excerpt, date }) {
+  return [
+    `<a class="blog-card" data-category="${escapeHtml(category)}" href="/blog/${escapeHtml(slug)}/">`,
+    `<div class="card-category">${escapeHtml(category)}</div>`,
+    `<h2 class="card-title">${escapeHtml(title)}</h2>`,
+    `<p class="card-excerpt">${escapeHtml(excerpt)}</p>`,
+    `<div class="card-footer"><span class="card-date">${escapeHtml(date)}</span><span class="card-read">Read →</span></div>`,
+    "</a>"
+  ].join("");
+}
+
+export function spanishCardHtml({ category, slug, title, excerpt, date }) {
+  return [
+    `    <a href="/es/blog/${escapeHtml(slug)}/" class="blog-card" data-category="${escapeHtml(category)}">`,
+    `      <div class="card-category">${escapeHtml(category)}</div>`,
+    `      <h2 class="card-title">${escapeHtml(title)}</h2>`,
+    `      <p class="card-excerpt">${escapeHtml(excerpt)}</p>`,
+    `      <div class="card-footer"><span class="card-date">${escapeHtml(date)}</span><span class="card-read">Leer →</span></div>`,
+    "    </a>"
+  ].join("\n");
+}
+
+export function insertCardByDate(listingHtml, cardHtml, dateYmd, { position = "date" } = {}) {
+  const html = String(listingHtml ?? "");
+  const grid = html.search(/<div class="card-grid" id="blogGrid">/);
+  if (grid < 0) throw new Error("blog listing is missing #blogGrid");
+
+  const cardRe = /<a\b(?=[^>]*\bclass="[^"]*\bblog-card\b)[^>]*>[\s\S]*?<\/a>/gi;
+  const cards = [...html.matchAll(cardRe)];
+  if (!cards.length) {
+    const openEnd = html.indexOf(">", grid) + 1;
+    return html.slice(0, openEnd) + "\n" + cardHtml + html.slice(openEnd);
+  }
+
+  if (position === "first") {
+    return html.slice(0, cards[0].index) + cardHtml + "\n" + html.slice(cards[0].index);
+  }
+
+  for (const card of cards) {
+    const dateMatch = card[0].match(/class="card-date"[^>]*>\s*(\d{4}-\d{2}-\d{2})/);
+    const cardDate = dateMatch?.[1];
+    if (cardDate && cardDate < dateYmd) {
+      return html.slice(0, card.index) + cardHtml + html.slice(card.index);
+    }
+  }
+  const last = cards[cards.length - 1];
+  const end = last.index + last[0].length;
+  return html.slice(0, end) + cardHtml + html.slice(end);
+}
+
+export function insertSitemapUrls({ sitemap, enUrl, esUrl, lastmod }) {
+  const xml = String(sitemap ?? "");
+  if (xml.includes(enUrl)) return xml;
+  const block = [
+    "",
+    `<!-- blog ${lastmod} -->`,
+    `<url><loc>${enUrl}</loc><lastmod>${lastmod}</lastmod><changefreq>monthly</changefreq><priority>0.7</priority>`,
+    `  <xhtml:link rel="alternate" hreflang="en" href="${enUrl}"/>`,
+    esUrl ? `  <xhtml:link rel="alternate" hreflang="es" href="${esUrl}"/>` : null,
+    "</url>",
+    esUrl
+      ? `<url><loc>${esUrl}</loc><lastmod>${lastmod}</lastmod><changefreq>monthly</changefreq><priority>0.7</priority>
+  <xhtml:link rel="alternate" hreflang="es" href="${esUrl}"/>
+  <xhtml:link rel="alternate" hreflang="en" href="${enUrl}"/>
+</url>`
+      : null,
+    ""
+  ]
+    .filter((line) => line !== null)
+    .join("\n");
+
+  if (xml.includes("</urlset>")) {
+    return xml.replace("</urlset>", `${block}</urlset>`);
+  }
+  return xml + block;
+}
+
+function escapeHtml(value) {
+  return String(value ?? "")
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;");
+}
+
+function decodeContent(file) {
+  if (!file?.content) return "";
+  return Buffer.from(String(file.content).replace(/\n/g, ""), "base64").toString("utf8");
+}
+
+async function githubJson(path, { method = "GET", token, body, fetchImpl = fetch } = {}) {
+  const response = await fetchImpl(`https://api.github.com/repos/${path}`, {
+    method,
+    headers: {
+      Authorization: `Bearer ${token}`,
+      Accept: "application/vnd.github+json",
+      "Content-Type": "application/json",
+      "User-Agent": "igor-v2"
+    },
+    body: body ? JSON.stringify(body) : undefined,
+    signal: AbortSignal.timeout(25_000)
+  });
+  const text = await response.text();
+  let parsed;
+  try {
+    parsed = text ? JSON.parse(text) : {};
+  } catch {
+    parsed = { text: text.slice(0, 2_000) };
+  }
+  if (!response.ok) {
+    const message = parsed.message || parsed.error || text.slice(0, 400);
+    const error = new Error(`GitHub HTTP ${response.status}: ${message}`);
+    error.status = response.status;
+    error.detail = parsed;
+    throw error;
+  }
+  return parsed;
+}
+
+export function previewPublishBlog(args, { now = new Date() } = {}) {
+  const date = String(args.date ?? todayYmdET(now)).slice(0, 10);
+  const dateIso = noonUtcIso(date);
+  if (!dateIso) return { error: "date must be YYYY-MM-DD." };
+
+  const enSlug = slugify(args.enSlug || args.slug);
+  if (!enSlug) return { error: "enSlug is required." };
+  const esSlug = args.esMarkdown || args.esSlug ? slugify(args.esSlug) : "";
+  if ((args.esMarkdown || args.esTitle) && !esSlug) return { error: "esSlug is required when posting Spanish." };
+
+  const category = String(args.category || "Medicare").trim() || "Medicare";
+  const enTitle = String(args.enTitle || args.title || "").trim();
+  const enDescription = String(args.enDescription || args.description || "").trim();
+  const enBody = String(args.enMarkdown || args.markdown || "").trim();
+  if (!enTitle || !enDescription || !enBody) {
+    return { error: "enTitle, enDescription, and enMarkdown are required." };
+  }
+
+  const enError = validatePostCopy(enBody);
+  if (enError) return { error: enError };
+  if (args.esMarkdown) {
+    const esError = validatePostCopy(args.esMarkdown);
+    if (esError) return { error: esError };
+  }
+
+  const enMarkdown = ensureFrontMatter(enBody, {
+    layout: "layouts/blog-post.njk",
+    category,
+    title: enTitle,
+    description: enDescription,
+    dateIso,
+    lang: "en",
+    hreflangEs: esSlug ? `/es/blog/${esSlug}/` : undefined,
+    permalink: `/blog/${enSlug}/`
+  });
+
+  let esMarkdown = null;
+  if (esSlug) {
+    const esTitle = String(args.esTitle || "").trim();
+    const esDescription = String(args.esDescription || "").trim();
+    const esBody = String(args.esMarkdown || "").trim();
+    if (!esTitle || !esDescription || !esBody) {
+      return { error: "esTitle, esDescription, and esMarkdown are required for the Spanish twin." };
+    }
+    esMarkdown = ensureFrontMatter(esBody, {
+      layout: "layouts/blog-post-es.njk",
+      category,
+      title: esTitle,
+      description: esDescription,
+      dateIso,
+      lang: "es",
+      hreflangEn: enSlug,
+      permalink: `/es/blog/${esSlug}/`
+    });
+  }
+
+  const mode = args.mode === "live" ? "live" : "pr";
+  return {
+    date,
+    dateIso,
+    category,
+    mode,
+    enSlug,
+    esSlug: esSlug || null,
+    enTitle,
+    esTitle: esSlug ? String(args.esTitle).trim() : null,
+    enMarkdown,
+    esMarkdown,
+    enCardTitle: String(args.enCardTitle || enTitle).trim(),
+    enCardExcerpt: String(args.enCardExcerpt || enDescription).trim(),
+    esCardTitle: esSlug ? String(args.esCardTitle || args.esTitle).trim() : null,
+    esCardExcerpt: esSlug ? String(args.esCardExcerpt || args.esDescription).trim() : null,
+    enUrl: `https://www.healthexps.com/blog/${enSlug}/`,
+    esUrl: esSlug ? `https://www.healthexps.com/es/blog/${esSlug}/` : null
+  };
+}
+
+export async function publishBlog(rawArgs, {
+  environment = process.env,
+  fetchImpl = fetch,
+  now = new Date()
+} = {}) {
+  const preview = previewPublishBlog(rawArgs, { now });
+  if (preview.error) return preview;
+
+  if (rawArgs.confirmed !== true) {
+    return {
+      needsConfirmation: true,
+      action: "publish_blog",
+      mode: preview.mode,
+      title: preview.enTitle,
+      date: preview.date,
+      urls: [preview.enUrl, preview.esUrl].filter(Boolean),
+      hint: preview.mode === "live"
+        ? "This will open a PR on healthexps-www and merge it to main (Netlify deploy). Confirm in chat, then call again with confirmed=true."
+        : "This will open a PR on healthexps-www. It will not go live until that PR is merged. Confirm in chat, then call again with confirmed=true."
+    };
+  }
+
+  const token = environment.GITHUB_TOKEN;
+  if (!token) return { error: "GITHUB_TOKEN is not set on Igor V2." };
+
+  const repo = SITE_REPO;
+  const base = environment.GITHUB_SITE_BASE_BRANCH || DEFAULT_BASE_BRANCH;
+  const branch = `igor/blog-${preview.enSlug}`.slice(0, 80);
+  const gh = (path, opts) => githubJson(path, { ...opts, token, fetchImpl });
+
+  try {
+    const ref = await gh(`${repo}/git/ref/heads/${base}`);
+    const baseSha = ref.object?.sha;
+    if (!baseSha) return { error: `Could not read ${base} SHA.` };
+
+    try {
+      await gh(`${repo}/git/refs`, {
+        method: "POST",
+        body: { ref: `refs/heads/${branch}`, sha: baseSha }
+      });
+    } catch (error) {
+      if (error.status !== 422) throw error;
+    }
+
+    async function putFile(path, content, message) {
+      let sha;
+      try {
+        const existing = await gh(`${repo}/contents/${path}?ref=${encodeURIComponent(branch)}`);
+        sha = existing.sha;
+      } catch (error) {
+        if (error.status !== 404) throw error;
+      }
+      return gh(`${repo}/contents/${path}`, {
+        method: "PUT",
+        body: {
+          message,
+          content: Buffer.from(content, "utf8").toString("base64"),
+          branch,
+          sha
+        }
+      });
+    }
+
+    await putFile(
+      `blog/${preview.enSlug}.md`,
+      preview.enMarkdown,
+      `Add EN blog ${preview.enSlug}`
+    );
+    if (preview.esMarkdown) {
+      await putFile(
+        `es/blog/${preview.esSlug}.md`,
+        preview.esMarkdown,
+        `Add ES blog ${preview.esSlug}`
+      );
+    }
+
+    const enListing = await gh(`${repo}/contents/blog/index.html?ref=${encodeURIComponent(branch)}`);
+    const enHtml = insertCardByDate(
+      decodeContent(enListing),
+      englishCardHtml({
+        category: preview.category,
+        slug: preview.enSlug,
+        title: preview.enCardTitle,
+        excerpt: preview.enCardExcerpt,
+        date: preview.date
+      }),
+      preview.date
+    );
+    await putFile("blog/index.html", enHtml, `List EN card for ${preview.enSlug}`);
+
+    if (preview.esSlug) {
+      const esListing = await gh(`${repo}/contents/es/blog/index.html?ref=${encodeURIComponent(branch)}`);
+      const esHtml = insertCardByDate(
+        decodeContent(esListing),
+        spanishCardHtml({
+          category: preview.category,
+          slug: preview.esSlug,
+          title: preview.esCardTitle,
+          excerpt: preview.esCardExcerpt,
+          date: preview.date
+        }),
+        preview.date,
+        { position: "first" }
+      );
+      await putFile("es/blog/index.html", esHtml, `List ES card for ${preview.esSlug}`);
+    }
+
+    const sitemapFile = await gh(`${repo}/contents/sitemap.xml?ref=${encodeURIComponent(branch)}`);
+    const sitemap = insertSitemapUrls({
+      sitemap: decodeContent(sitemapFile),
+      enUrl: preview.enUrl,
+      esUrl: preview.esUrl,
+      lastmod: preview.date
+    });
+    await putFile("sitemap.xml", sitemap, `Sitemap for ${preview.enSlug}`);
+
+    const pr = await gh(`${repo}/pulls`, {
+      method: "POST",
+      body: {
+        title: preview.enTitle,
+        head: branch,
+        base,
+        body: [
+          `Telegram Igor publish (${preview.mode}).`,
+          "",
+          `- EN: ${preview.enUrl}`,
+          preview.esUrl ? `- ES: ${preview.esUrl}` : null,
+          `- Date: ${preview.date}`,
+          "",
+          "We do not pick the plan. Header/footer/GA4/canonical/TPMO come from the Eleventy blog layouts."
+        ]
+          .filter(Boolean)
+          .join("\n")
+      }
+    });
+
+    let merged = false;
+    let mergeError = null;
+    if (preview.mode === "live" && pr.number) {
+      try {
+        await gh(`${repo}/pulls/${pr.number}/merge`, {
+          method: "PUT",
+          body: {
+            merge_method: "squash",
+            commit_title: preview.enTitle
+          }
+        });
+        merged = true;
+      } catch (error) {
+        mergeError = error.message;
+      }
+    }
+
+    return {
+      published: true,
+      merged,
+      mergeError,
+      mode: preview.mode,
+      branch,
+      prUrl: pr.html_url,
+      prNumber: pr.number,
+      urls: [preview.enUrl, preview.esUrl].filter(Boolean),
+      note: merged
+        ? "Merged to main. Netlify will deploy healthexps.com from that push."
+        : "PR opened. It is not live until merged to main."
+    };
+  } catch (error) {
+    return {
+      error: error.message,
+      hint: error.status === 403 || error.status === 404
+        ? "GITHUB_TOKEN on Igor V2 needs Contents + Pull requests write on yperez-dot/healthexps-www."
+        : undefined
+    };
+  }
+}
