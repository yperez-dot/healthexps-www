:root{--purple:#452068;--pink:#ff1090;--ink:#1a1325;--muted:#3a2f47;}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:#fff;line-height:1.7;font-size:18px;}
a{text-decoration:none;color:inherit}
.wrap{max-width:760px;margin:0 auto;padding:0 24px;}
.article{padding:60px 0;}
.article-header{margin-bottom:40px;border-bottom:2px solid #f4eefa;padding-bottom:24px;}
.article-category{display:inline-block;background:#f4eefa;color:var(--purple);font-size:14.5px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;padding:4px 12px;border-radius:50px;margin-bottom:14px;}
.article-title{font-size:36px;font-weight:700;color:#1a1325;margin-bottom:12px;line-height:1.2;}
.article-body h1{font-size:36px;font-weight:700;color:#1a1325;margin-bottom:12px;line-height:1.2;}
.article-meta{font-size:17px;color:var(--muted);}
.article-body{font-size:18px;line-height:1.8;color:#3a2f47;}
.article-body h2{font-size:28px;font-weight:700;color:var(--purple);margin:40px 0 16px;}
.article-body h3{font-size:22px;font-weight:700;color:var(--purple);margin:32px 0 12px;}
.article-body p{margin-bottom:20px;}
.article-body ul,.article-body ol{margin:20px 0 20px 32px;}
.article-body li{margin-bottom:12px;}
.article-body strong{color:var(--purple);font-weight:700;}
.article-body a{color:var(--pink);font-weight:600;}
.article-body a:hover{text-decoration:underline;}
.article-body table{width:100%;border-collapse:collapse;margin:24px 0;font-size:18px;}
.article-body th{background:#f4eefa;color:var(--purple);padding:10px 14px;text-align:left;font-weight:700;}
.article-body td{padding:10px 14px;border-bottom:1px solid #e5e5e5;}
.article-body tr:last-child td{border-bottom:none;}
.inline-cta{border-left:3px solid var(--purple);background:#f7f7f7;border-radius:0 8px 8px 0;padding:20px 24px;margin:40px 0;display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap;}
.inline-cta-text{flex:1;min-width:240px;}
.inline-cta-text strong{display:block;font-size:18px;color:var(--purple);margin-bottom:6px;}
.inline-cta-text span{font-size:18px;color:var(--muted);}
.inline-cta-btn{background:var(--purple);color:#fff;padding:12px 24px;border-radius:8px;font-weight:600;font-size:17px;text-decoration:none;white-space:nowrap;transition:all 0.2s;}
.inline-cta-btn:hover{background:#311549;}
.bottom-cta{background:var(--purple);border-radius:12px;padding:40px;text-align:center;margin:60px 0 40px;}
.bottom-cta h3{color:white;font-size:28px;margin-bottom:12px;}
.bottom-cta p{color:rgba(255,255,255,0.9);font-size:16px;margin-bottom:24px;}
.bottom-cta-btn{background:var(--pink);color:white;padding:14px 32px;border-radius:50px;font-weight:700;font-size:16px;text-decoration:none;display:inline-block;}
.bottom-cta-btn:hover{background:#d4006d;}
.tpmo-disclaimer{font-size:14px;color:#5a5068;line-height:1.7;padding:20px 0;border-top:1px solid #e5e5e5;margin-top:40px;}
.back-link{color:#452068;font-weight:600;font-size:16px;text-decoration:none;display:inline-block;margin-bottom:40px;}
.back-link:hover{text-decoration:underline;}
#scrollToTop{display:none;position:fixed;bottom:28px;right:28px;width:48px;height:48px;background:#452068;color:#fff;border:none;border-radius:50%;font-size:22px;font-weight:700;cursor:pointer;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(69,32,104,.35);z-index:998;transition:background .2s,transform .15s;}
#scrollToTop:hover{background:#ff1090;transform:translateY(-2px);}

.v4-nav-dropdown{display:none;}
.v4-nav-item:hover .v4-nav-dropdown{display:block;}
.v4-nav-mobile-btn{display:none;background:none;border:none;cursor:pointer;padding:8px;}
#v4-mobile-menu{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:#fff;z-index:999;overflow-y:auto;padding:24px;}
#v4-mobile-menu.open{display:block;}
#v4-mobile-menu a,.v4-nav-outer a,.v4-nav-desktop a{text-decoration:none!important;}
.v4-nav-outer .v4-nav-desktop>a,.v4-nav-outer .v4-nav-desktop>.v4-nav-item>a{color:#3a2f47;}
.v4-nav-outer .v4-nav-desktop>a[href="/es/blog/"]{color:#452068;}
.v4-nav-dropdown a{color:#241a30!important;}
@media(max-width:900px){
  .v4-nav-desktop{display:none !important;}
  .v4-nav-mobile-btn{display:flex !important;align-items:center;}
}
@media(max-width:768px){
  .v4-nav-outer,.top-bar-inner{padding-left:20px!important;padding-right:20px!important;}
}
</style>
