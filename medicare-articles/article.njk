---
pagination:
  data: medicareArticles
  size: 1
  alias: article
permalink: "{{ article.slug }}/index.html"
layout: layouts/medicare-articles.njk
locale: en
---
<div class="container article-shell"><a class="back-link" href="/medicare-articles/">← Medicare articles</a>
<article><header class="article-header"><p class="eyebrow">Medicare guide</p><h1>{{ article.title }}</h1><p class="article-meta">Updated September 28, 2026 <span aria-hidden="true">·</span> {{ article.readMinutes }} min read{% if article.hasVideo %} <span aria-hidden="true">·</span> Video script ~{{ article.videoDurationEstimate }}{% endif %}</p></header>
{% if article.headings.length > 3 %}<nav class="toc" aria-label="On this page"><strong>On this page</strong><ol>{% for heading in article.headings %}<li><a href="#section-{{ loop.index }}">{{ heading }}</a></li>{% endfor %}</ol></nav>{% endif %}
<div class="article-body">{{ article.bodyHtml | safe }}</div>
{% if article.hasVideo %}<section class="transcript"><h2>Video transcript</h2>{{ article.transcriptHtml | safe }}<details><summary>Transcripción en español</summary>{% for line in article.transcriptEs %}<p lang="es">{{ line }}</p>{% endfor %}</details></section>{% endif %}
<section class="related"><h2>Related articles</h2><ul>{% for related in article.relatedArticles %}<li><a href="{{ related.slug }}/">{{ related.title }}</a></li>{% endfor %}</ul></section>
<section class="cta"><h2>Next step</h2><p>{{ article.nextStepHtml | safe }}</p><a class="button" href="/contact">Request your free plan review</a></section>
<aside class="disclaimer">{{ medicareHub.disclaimerEn }}</aside></article></div>
