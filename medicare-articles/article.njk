---
pagination:
  data: medicareArticles
  size: 1
  alias: article
permalink: "{{ article.slug }}/index.html"
layout: layouts/medicare-articles.njk
locale: en
---
<div class="container article-shell"><a class="back-link" href="/medicare-articles/">← Medicare articles</a>
<article><header class="article-header"><p class="eyebrow">Medicare guide</p><h1>{{ article.title }}</h1><p class="article-meta">Updated September 28, 2026 <span aria-hidden="true">·</span> {{ article.readMinutes }} min read{% if article.hasVideo %} <span aria-hidden="true">·</span> {% if article.videoSrc %}Video{% else %}Video script{% endif %} ~{{ article.videoDurationEstimate }}{% endif %}</p></header>
{% if article.quickAnswer %}<div class="quick-answer" style="background:#f4eefa;border:1px solid #e3d8ef;border-radius:12px;padding:14px 18px;margin:0 0 24px;color:#3a2468;"><p style="margin:0 0 4px;font-size:14px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:#452068;">Quick answer</p><p style="margin:0 0 12px;font-size:16px;line-height:1.5;color:#3a2468;">{{ article.quickAnswer }}</p>{% if article.quickAnswerCta %}<a href="{{ article.quickAnswerCta.href }}" style="display:inline-block;background:#452068;color:#ffffff;padding:8px 18px;border-radius:8px;font-weight:600;font-size:16px;text-decoration:none;">{{ article.quickAnswerCta.text }}</a>{% endif %}</div>{% endif %}
{% if article.videoFirst %}{% if article.videoSrc %}<figure class="article-video"><video controls playsinline preload="metadata" aria-label="{{ article.title }} video"><source src="{{ article.videoSrc }}" type="video/mp4"><a href="{{ article.videoSrc }}">Download the video</a></video><figcaption>Watch this short guide (~{{ article.videoDurationEstimate }}).</figcaption></figure>{% endif %}{% endif %}
{% if article.headings.length > 3 %}<nav class="toc" aria-label="On this page"><strong>On this page</strong><ol>{% for heading in article.headings %}<li><a href="#section-{{ loop.index }}">{{ heading }}</a></li>{% endfor %}</ol></nav>{% endif %}
{% if not article.videoFirst %}{% if article.videoSrc %}<figure class="article-video"><video controls playsinline preload="metadata" aria-label="{{ article.title }} video"><source src="{{ article.videoSrc }}" type="video/mp4"><a href="{{ article.videoSrc }}">Download the video</a></video><figcaption>Watch this short guide (~{{ article.videoDurationEstimate }}).</figcaption></figure>{% endif %}{% endif %}
<div class="article-body">{{ article.bodyHtml | safe }}</div>
{% if article.hasVideo %}<section class="transcript"><h2>Video transcript</h2>{{ article.transcriptHtml | safe }}<details><summary>Transcripción en español</summary>{% for line in article.transcriptEs %}<p lang="es">{{ line }}</p>{% endfor %}</details></section>{% endif %}
<section class="related"><h2>Related articles</h2><ul>{% for related in article.relatedArticles %}<li><a href="{{ related.slug }}/">{{ related.title }}</a></li>{% endfor %}</ul></section>
<section class="cta"><h2>Next step</h2><p>{{ article.nextStepHtml | safe }}</p><a class="button" href="/contact">Request your free plan review</a></section>
<aside class="disclaimer">{{ medicareHub.disclaimerEn }}</aside></article></div>
